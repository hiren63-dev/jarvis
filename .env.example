# Jarvis AI Assistant — Environment Variables
# Copy this file to .env and fill in your API key(s)

# ── LLM Provider API Keys (set at least one) ──
# OpenAI (recommended — covers GPT-4, Whisper STT, and Vision)
OPENAI_API_KEY=sk-your-openai-key-here

# Google Gemini (free tier available at https://aistudio.google.com)
# GEMINI_API_KEY=your-gemini-key-here

# Anthropic Claude
# ANTHROPIC_API_KEY=your-anthropic-key-here

# Ollama (local — no key needed, just run `ollama serve`)
# No key required — set llm_provider to "ollama" in config
